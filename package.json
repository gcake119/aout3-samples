{
  "name": "aout3-samples",
  "version": "1.0.0",
  "description": "Code Samples for Art of Unit Testing 3rd Edition",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "ch1": "semistandard --fix ch1-basics && node ch1-basics/custom-test-phase1.js && node ch1-basics/custom-test-phase2.js && node ch1-basics/custom-test-phase3.js"
  },
  "semistandard": {
    "env": [
      "vitest"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royosherove/aout3-samples.git"
  },
  "author": "Roy Osherove",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/royosherove/aout3-samples/issues"
  },
  "homepage": "https://github.com/royosherove/aout3-samples#readme",
  "devDependencies": {
    "@vitest/ui": "^4.0.18",
    "colors": "^1.4.0",
    "eslint": "^9.39.2",
    "jsdom": "^23.2.0",
    "nock": "^13.5.6",
    "prettier": "^3.8.1",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "fs": "0.0.1-security",
    "lodash": "^4.17.23",
    "moment": "^2.30.1",
    "node-fetch": "^2.7.0",
    "semistandard": "^17.0.0",
    "winston": "^3.19.0"
  }
}
